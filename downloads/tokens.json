{
  "version": "0.2-proposal",
  "name": "Flagship Games",
  "description": "A recognisable paper-and-ink shop frame with flexible game expression",
  "colors": {
    "primary": "#B6A27A",
    "ink": "#303C38",
    "paper": "#F7F5EF",
    "surface": "#FFFEF9",
    "muted": "#626A62",
    "border": "#858A7F",
    "line": "#D6D2C7",
    "soft": "#ECE8DE",
    "success": "#285B3D",
    "warning": "#715013",
    "danger": "#943D32",
    "focus": "#254B62",
    "focus-inverse": "#F8E9C6",
    "ink-hover": "#43544C",
    "clay": "#9B5945",
    "logo-gold": "#BAAC7F",
    "campaign-fantasy": "#CDD7AE",
    "campaign-future": "#C8D9E5",
    "campaign-community": "#E7C7AF"
  },
  "typography": {
    "display": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "56px",
      "fontWeight": 750,
      "lineHeight": 1.05,
      "letterSpacing": "-0.025em"
    },
    "heading": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "36px",
      "fontWeight": 700,
      "lineHeight": 1.12
    },
    "subheading": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "24px",
      "fontWeight": 650,
      "lineHeight": 1.2
    },
    "feature": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "40px",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "caption": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "badge": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "12px",
      "fontWeight": 650,
      "lineHeight": 1.5
    },
    "body": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "label": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 600,
      "lineHeight": 1.4
    },
    "campaign": {
      "fontFamily": "'Barlow Condensed', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "54px",
      "fontWeight": 700,
      "lineHeight": 1.02
    },
    "control": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "mobile-title": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "32px",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "mobile-display": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "48px",
      "fontWeight": 750,
      "lineHeight": 1.2
    },
    "specimen": {
      "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif",
      "fontSize": "64px",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "code": {
      "fontFamily": "ui-monospace, SFMono-Regular, Consolas, monospace",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.ink}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.sm}"
    },
    "input": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.sm}"
    }
  }
}
